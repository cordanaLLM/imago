{
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main",
        "refs/heads/lts-*"
      ]
    }
  },
  "enforcement": "active",
  "name": "praetor-main-protection",
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      },
      "type": "pull_request"
    },
    {
      "parameters": {
        "required_status_checks": [
          {
            "context": "Strict MkDocs Build"
          },
          {
            "context": "Secret \u0026 Privacy Leak Scan"
          },
          {
            "context": "Packer Format \u0026 Validate"
          },
          {
            "context": "Ruff Lint \u0026 Format"
          },
          {
            "context": "ShellCheck \u0026 Shfmt Provisioners"
          },
          {
            "context": "Codespell"
          },
          {
            "context": "Actionlint \u0026 Yamllint"
          },
          {
            "context": "Go Build \u0026 Unit Tests"
          },
          {
            "context": "Pytest Verification Suite"
          },
          {
            "context": "CodeQL (go)"
          },
          {
            "context": "CodeQL (python)"
          },
          {
            "context": "Validate PR Milestone \u0026 Metadata"
          },
          {
            "context": "Documentation Governance"
          },
          {
            "context": "required-checks"
          },
          {
            "context": "REUSE lint"
          },
          {
            "context": "Gitleaks History Scan"
          },
          {
            "context": "Govulncheck Reachable Go Vulnerabilities"
          },
          {
            "context": "Semgrep SAST"
          },
          {
            "context": "Trivy Filesystem CVE Scan"
          }
        ],
        "strict_required_status_checks_policy": true
      },
      "type": "required_status_checks"
    }
  ],
  "target": "branch"
}