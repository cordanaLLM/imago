{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "pinDigests": true
    },
    {
      "matchManagers": [
        "pip_requirements",
        "setup-cfg",
        "pep621"
      ],
      "groupName": "python-tooling",
      "groupSlug": "python-tooling"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go-modules",
      "groupSlug": "go-modules"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "container-images",
      "groupSlug": "container-images"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchFileNames": [
        "versions.json"
      ],
      "semanticCommitScope": "versions"
    },
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/praetor-docs.yml",
        "tools/markdownlint/package.json",
        "tools/markdownlint/package-lock.json",
        "tools/markdownlint/markdownlint-cli2.yaml",
        "tools/markdownlint/verify.mjs",
        "tools/markdownlint/no-private-scratch-links.mjs",
        "tools/figures/core.mjs",
        "tools/figures/checks.mjs",
        "tools/figures/build.mjs",
        "tools/figures/types.ts",
        "tools/figures/third_party/interfig/vendor.json",
        "tools/figures/third_party/interfig/VENDOR.md",
        "tools/figures/third_party/interfig/upstream/LICENSE",
        "tools/figures/third_party/interfig/upstream/src/svg.ts",
        "tools/figures/third_party/interfig/upstream/src/geometry.ts",
        "tools/figures/third_party/interfig/upstream/src/model.ts",
        "tools/figures/dist/loader.js",
        "tools/figures/dist/player.js",
        "tools/figures/dist/THIRD-PARTY-LICENSES.txt",
        "tools/figures/figures.css",
        "tools/figures/mkdocs_hook.py",
        "tools/figures/astro.mjs",
        "tools/figures/serve.mjs",
        "tools/figures/README.md",
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>(?:registry\\.k8s\\.io|docker\\.io|quay\\.io|ghcr\\.io|prom|nvcr\\.io|intel|rocm)[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>1\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"containerd\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "containerd/containerd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"container_toolkit\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "NVIDIA/nvidia-container-toolkit",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"docker_ce\":\\s*\"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "docker/cli",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"crun\":\\s*\"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "containers/crun",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"stargz_snapshotter\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "containerd/stargz-snapshotter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"cdebug\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "zerok-ai/cdebug",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"enroot\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "NVIDIA/enroot",
      "datasourceTemplate": "github-releases"
    }
  ]
}
